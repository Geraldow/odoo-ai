{
  "_comment": "Add these hooks to your ~/.claude/settings.json under the 'hooks' key.",
  "_note": "All scripts are installed to ~/.claude/scripts/ by install.ps1.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/scripts/engram-detect.py",
            "shell": "bash"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/scripts/odoo-detect.py",
            "shell": "bash"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/scripts/workflow-state-check.py",
            "shell": "bash"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -NonInteractive -File \"$HOME/.claude/scripts/engram-session-start.ps1\"",
            "timeout": 60,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -NonInteractive -File \"$HOME/.claude/scripts/engram-session-end.ps1\"",
            "timeout": 60
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"hookSpecificOutput\":{\"hookEventName\":\"Stop\",\"additionalContext\":\"[SKILL-EVOLVER CHECK] Before finishing: did this session introduce any reusable pattern (new SSH workflow, Odoo.sh ops, Docker setup, Odoo discovery, naming convention, new script, repeated multi-step process)? If yes → invoke skill-evolver NOW with a description of the pattern BEFORE saying done.\"}}'",
            "shell": "bash"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/scripts/sdd_task_check.py",
            "shell": "bash"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|Read",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/scripts/engram-project-track.py",
            "shell": "bash"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|Read|Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/scripts/sdd_odoo_check.py",
            "shell": "bash"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/scripts/git-protocol-check.py",
            "shell": "bash"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/scripts/sdd_task_check.py PostCompact",
            "shell": "bash"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -NonInteractive -File \"$HOME/.claude/scripts/engram-session-start.ps1\"",
            "timeout": 60,
            "async": true
          }
        ]
      }
    ]
  }
}
