#!/usr/bin/env pwsh
# commit-msg — Odoo project git hook
# Validates: Conventional Commits format + blocks AI attribution in commits
# NO Claude/MCP calls — pure PowerShell only

$ErrorActionPreference = "Stop"

$msgFile = $args[0]
if (-not $msgFile -or -not (Test-Path $msgFile)) { exit 0 }

$msg = Get-Content $msgFile -Raw -Encoding UTF8

# ─── Block AI attribution ────────────────────────────────────────────────────
$aiPatterns = @(
    'Co-Authored-By.*Claude',
    'Co-Authored-By.*GPT',
    'Co-Authored-By.*Copilot',
    'Co-Authored-By.*Gemini',
    'Generated by Claude',
    'Generated with Claude',
    'AI-generated',
    '🤖'
)

foreach ($pattern in $aiPatterns) {
    if ($msg -match $pattern) {
        Write-Host ""
        Write-Host "COMMIT BLOCKED: AI attribution detected in commit message."
        Write-Host "  Pattern matched: $pattern"
        Write-Host "  Rule: No AI Co-Authored-By lines in commits."
        Write-Host ""
        exit 1
    }
}

# ─── Conventional Commits validation ────────────────────────────────────────
# Format: type(scope): description  OR  type: description
# Allowed types: feat fix docs style refactor test chore build ci perf revert
$firstLine = ($msg -split "`n")[0].Trim()

# Skip merge and revert commits
if ($firstLine -match '^Merge ') { exit 0 }
if ($firstLine -match '^Revert ') { exit 0 }

$conventionalPattern = '^(feat|fix|docs|style|refactor|test|chore|build|ci|perf|revert)(\([a-z0-9_\-\.]+\))?(\!)?:\s+.{1,100}$'

if ($firstLine -notmatch $conventionalPattern) {
    Write-Host ""
    Write-Host "COMMIT BLOCKED: Message does not follow Conventional Commits format."
    Write-Host ""
    Write-Host "  Your message: $firstLine"
    Write-Host ""
    Write-Host "  Expected:  type(scope): description"
    Write-Host "  Examples:"
    Write-Host "    feat(account): add document type validation"
    Write-Host "    fix(stock): correct negative quantity handling"
    Write-Host "    chore: update manifest version to 18.0.1.2.0"
    Write-Host ""
    Write-Host "  Valid types: feat fix docs style refactor test chore build ci perf revert"
    Write-Host ""
    exit 1
}

# ─── Subject line length ─────────────────────────────────────────────────────
if ($firstLine.Length -gt 100) {
    Write-Host "COMMIT BLOCKED: Subject line too long ($($firstLine.Length) chars, max 100)."
    exit 1
}

exit 0
